# Voice gateway configuration. Copy to .env; .env is gitignored.
#
# Note what is absent and stays absent: a database URL. The gateway sits inside
# the PHI boundary but outside the persistence boundary (ADR-016, doc 03 §4).
# It hands each turn to the TypeScript tier over HTTP and cannot reach Postgres
# because it has no credentials to reach it with. Adding one here to save a
# round trip deletes the guarantee.

# --- Deepgram --------------------------------------------------------------
# Used for exactly one thing: minting short-lived tokens at the auth-grant
# endpoint. It never enters the STT or TTS request path.
# Leave empty to run in transcript mode (type answers instead of speaking).
VOICE_GATEWAY_DEEPGRAM_API_KEY=

# Bare hostname, no scheme. ADR-013 points at self-hosted Deepgram in
# ca-central-1; mip_opt_out becomes moot there and the URL choke point stays.
VOICE_GATEWAY_DEEPGRAM_HOST=api.deepgram.com
VOICE_GATEWAY_DEEPGRAM_TOKEN_TTL_SECONDS=30

VOICE_GATEWAY_STT_MODEL=nova-3-medical
VOICE_GATEWAY_STT_ENDPOINTING_MS=400
VOICE_GATEWAY_STT_UTTERANCE_END_MS=1500

# 05 §7 lists harmonia and vesta as the clinical-tone candidates and calls the
# choice a product decision for the clinical lead. This is the placeholder.
VOICE_GATEWAY_TTS_MODEL=aura-2-harmonia-en

# --- Audio -----------------------------------------------------------------
VOICE_GATEWAY_BROWSER_SAMPLE_RATE=16000
VOICE_GATEWAY_TTS_SAMPLE_RATE=24000
VOICE_GATEWAY_AUDIO_CACHE_DIR=audio-cache

# `SpeechStarted` in, Aura `Clear` out. The primitives are wired; the policy is
# not decided. Off by default — a patient saying "um" three words in would cut
# the question off, and 05 §4 expects VAD false positives in a clinic room.
VOICE_GATEWAY_BARGE_IN_ENABLED=false

VOICE_GATEWAY_MAX_RECONNECT_ATTEMPTS=5
VOICE_GATEWAY_RECONNECT_BACKOFF_SECONDS=0.5

# --- The TypeScript persistence hop (ADR-016) ------------------------------
# Slice 2 ships a stub at this address: `uv run python -m
# voice_gateway.persistence.stub_server`. The real endpoint is the Next.js app.
VOICE_GATEWAY_PERSIST_TURN_URL=http://127.0.0.1:8787/api/internal/intake/turn
VOICE_GATEWAY_PERSIST_TURN_TOKEN=dev-shared-secret
VOICE_GATEWAY_PERSIST_TIMEOUT_SECONDS=5.0

# --- Telemetry (doc 06 §3) -------------------------------------------------
# Production posture. Never true on a deployment that sees real patient
# traffic; slice 4 owns the two-project split that makes the eval path safe.
VOICE_GATEWAY_LANGFUSE_CAPTURE_INPUT=false
VOICE_GATEWAY_LANGFUSE_CAPTURE_OUTPUT=false

# --- Server ----------------------------------------------------------------
VOICE_GATEWAY_HOST=127.0.0.1
VOICE_GATEWAY_PORT=8080
